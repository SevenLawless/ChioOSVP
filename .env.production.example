# ChioOS production environment example
# Copy this file to .env.production and fill in your own values.

NODE_ENV=production
PORT=4001

MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=life_os_v1
MYSQL_USER=chioos_user
MYSQL_PASSWORD=change_this_app_password

DB_HOST=mysql
DB_PORT=3306
DB_USER=chioos_user
DB_PASSWORD=change_this_app_password
DB_NAME=life_os_v1

UPLOADS_DIR=../uploads

# Bind host for the app container (use 127.0.0.1 to keep it local-only)
CHIOOS_BIND_HOST=127.0.0.1
